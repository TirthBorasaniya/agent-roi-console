# Copy to .env and fill in. Every variable is optional: with no connector keys the
# console runs in demo mode on recorded fixtures, and with no LLM keys the gateway
# serves recorded responses only.

# ============= LLM providers =============
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# self-hosted llama.cpp server (compose service "llamacpp")
SELFHOSTED_BASE_URL=http://localhost:8081/v1

# ============= Gateway =============
GATEWAY_URL=http://localhost:8090/v1
GATEWAY_API_KEY=
GATEWAY_STRICT=true
REDIS_URL=redis://localhost:6379/0

# ============= Connectors =============
# live | dryrun | demo; unset means live when all three keys are set, demo otherwise
ROI_CONNECTOR_MODE=
SLACK_BOT_TOKEN=
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=
# self-hosted Twenty (compose profile "crm"); generate with: openssl rand -base64 32
TWENTY_ENCRYPTION_KEY=
TWENTY_PG_PASSWORD=
TWENTY_SERVER_URL=http://localhost:3000
SLACK_MCP_URL=
NOTION_MCP_URL=
CRM_MCP_URL=

# ============= Telemetry =============
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============= Console API =============
FRONTEND_ORIGIN=http://localhost:5173
RUN_RATE_LIMIT=10
RUN_RATE_WINDOW_SECONDS=60
GUARD_ENABLED=false
GUARD_INTERVAL_SECONDS=900
