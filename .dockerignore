.git
.gitignore
.venv
venv

# local SQLite state. must use **/ : a bare "data" matches only the context
# root, which previously let backend/data/roi_console.db (created by local
# pytest runs) get baked into the image and shipped with the deployment
**/data/
**/*.db
**/*.sqlite
**/*.sqlite3

**/node_modules
**/dist
# generated at build time by the frontend stage, never copied from the host
backend/static
**/__pycache__
**/*.pyc
**/.pytest_cache

.DS_Store
.claude
CLAUDE.md
.env
.env.*
!.env.example
README.md
LICENSE
docker-compose.yml
